{
  "version": 10,
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW Makefiles",
      "description": "Using MinGW Makefiles generator",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw",
      "jobs": 4
    }
  ]
}
