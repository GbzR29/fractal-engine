# Exemplo de CMakeLists.txt para um Módulo
# Coloque em src/graphics/CMakeLists.txt (como exemplo)

# Definir sources deste módulo
set(GRAPHICS_SOURCES
    ${CMAKE_CURRENT_SOURCE_DIR}/Shader.cpp
    ${CMAKE_CURRENT_SOURCE_DIR}/Texture.cpp
    ${CMAKE_CURRENT_SOURCE_DIR}/TextureLoader.cpp
    ${CMAKE_CURRENT_SOURCE_DIR}/Camera.cpp
    ${CMAKE_CURRENT_SOURCE_DIR}/Material.cpp
)

# Adicionar sources à biblioteca principal
target_sources(${PROJECT_NAME}_lib PRIVATE ${GRAPHICS_SOURCES})

# Opcionalmente, você pode criar uma biblioteca separada para este módulo
# add_library(FractalEngine_Graphics ${GRAPHICS_SOURCES})
# target_include_directories(FractalEngine_Graphics PUBLIC ${CMAKE_SOURCE_DIR}/include)
# target_link_libraries(FractalEngine_Graphics PUBLIC ${PROJECT_NAME}_lib)

message(STATUS "Added Graphics module sources")
